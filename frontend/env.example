# API Configuration
## IMPORTANT: set this to the backend URL (include the port the backend bound to)
## If your system blocks port 5000 (macOS services sometimes use it), the backend may bind to 5001.
VITE_API_BASE_URL=http://localhost:5001/api

# Web3 Configuration
VITE_WEB3_PROVIDER_URL=http://localhost:8545
VITE_CONTRACT_ADDRESS=your_contract_address_here

# App Configuration
VITE_APP_NAME=SolarDraft
VITE_APP_VERSION=1.0.0 